# Frontend build settings (copy to .env.production / .env.development; real .env files are git-ignored).
# Site-wide screenshot deterrent. Unset = ON for `npm run build` (production) and OFF for `npm run dev`.
# Force with true / false. Rebuild after changing: the value is baked into the bundle.
# VITE_SCREENSHOT_PROTECTION=true

# Absolute API origin when the API lives on its own host (no trailing slash). Unset = same-origin /api/v1 (nginx proxies /api).
# Rebuild after changing: the value is baked into the bundle. Backend CORS_ORIGIN must then be the site's origin.
# VITE_API_BASE_URL=https://api.sankatmochansaarthi.com
