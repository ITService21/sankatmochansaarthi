# --- Server ---
NODE_ENV=development
PORT=4000
# Production behind Nginx: HOST=127.0.0.1
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# --- MySQL ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=education_site

# --- Administrator bootstrap (read ONLY by `npm run seed`; never committed) ---
ADMIN_USERNAME=Administrator
ADMIN_BOOTSTRAP_PASSWORD=
# true => Administrator must change the bootstrap password at first login
ADMIN_REQUIRE_PASSWORD_CHANGE=true

# --- Storage: s3 | local ---
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage-data
AWS_REGION=ap-south-1
S3_BUCKET=
# Credentials come from the standard AWS provider chain (env/role); never commit them.

# --- Uploads ---
MAX_UPLOAD_MB=25

# --- Payments: fake | razorpay ---
PAYMENT_PROVIDER=fake
PAYMENT_WEBHOOK_SECRET=change-me-webhook-secret
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Social sign-in (Google / Microsoft). Leave blank to disable a provider. See README "Social sign-in".
# Redirect URIs to register: <OAUTH_REDIRECT_BASE>/api/v1/auth/oauth/google/callback  and  .../microsoft/callback
OAUTH_REDIRECT_BASE=http://localhost:5173
FRONTEND_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# "common" = any Microsoft account (work, school, personal); or your tenant id to restrict
MICROSOFT_TENANT=common

# `npm run migrate` also creates the default accounts (Administrator, student1, teacher1) when missing.
# Set to false to skip (see src/seeds/default-accounts.seed.ts).
SEED_DEFAULT_ACCOUNTS=true
